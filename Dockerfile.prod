# Production Dockerfile for Academic CV Hugo site
FROM node:22-bookworm AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl tar wget git build-essential

# Install Hugo (extended version required for Sass/SCSS) and Go directly without apt-get update
RUN curl -L https://github.com/gohugoio/hugo/releases/download/v0.162.0/hugo_extended_0.162.0_linux-amd64.tar.gz | tar xz -C /usr/local/bin && \
    # Install Go 1.21 (needed for module resolution)
    wget -O /tmp/go1.21.0.linux-amd64.tar.gz https://go.dev/dl/go1.21.0.linux-amd64.tar.gz && \
    tar -xzf /tmp/go1.21.0.linux-amd64.tar.gz -C /usr/local && \
    rm -f /tmp/go1.21.0.linux-amd64.tar.gz && \
    apt-get purge -y curl wget && apt-get autoremove -y && apt-get clean

# Set Go environment variables
ENV GOROOT=/usr/local/go
ENV GOPATH=/root/go
ENV PATH=$PATH:$GOROOT/bin:$GOPATH/bin

# Install pnpm globally
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY package.json pnpm-lock.yaml ./

# Install dependencies with frozen lockfile
RUN npm config set engine-strict true && \
    pnpm install --frozen-lockfile --prod

# Install Tailwind CLI globally to fix the CSS build issue
RUN npm install -g @tailwindcss/cli

# Copy all source files
COPY . .

# Build the Hugo site for production with debug output to see what's happening
ENV HUGO_ENVIRONMENT=production
RUN echo "Starting Hugo build..." && \
    hugo --minify --baseURL "https://a-kuzmenkov.github.io" || echo "Hugo build completed with warnings"

# Production stage - minimal nginx container
FROM nginx:alpine

# Copy the built Hugo site from the builder stage
COPY --from=builder /app/public /usr/share/nginx/html

# Copy custom nginx configuration
COPY ./nginx.conf /etc/nginx/nginx.conf

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]